# Configurações da Aplicação
ENVIRONMENT=development
DEBUG=True

# Banco de Dados
# Em produção (Render), esta variável é definida automaticamente
# Em desenvolvimento, use SQLite
DATABASE_URL=sqlite:///./app.db

# Autenticação
SECRET_KEY=sua-chave-secreta-super-segura-mude-isto-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin (Usuário padrão criado na primeira execução)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Upload de Arquivos
UPLOAD_DIRECTORY=app/static/uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpeg,png,gif,webp

# CORS
CORS_ORIGINS=*

# Notas para Production (Render):
# 1. Alterar DEBUG para False
# 2. Alterar ENVIRONMENT para production
# 3. Gerar nova SECRET_KEY segura (execute: python -c "import secrets; print(secrets.token_urlsafe(32))")
# 4. DATABASE_URL será definido automaticamente pelo Render
# 5. Definir ADMIN_USERNAME, ADMIN_EMAIL e ADMIN_PASSWORD com credenciais seguras
